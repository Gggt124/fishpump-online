        "name": "Route",
        "debugMode": false,
        "singletonMode": false,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "TBEL",
          "jsScript": "return ['drop'];",
          "tbelScript": "return [metadata.alarmRoute];"
        },
        "additionalInfo": {
          "layoutX": 1500,
          "layoutY": 200
        }
      },
