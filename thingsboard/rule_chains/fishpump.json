        "debugMode": false,
        "singletonMode": false,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "TBEL",
          "jsScript": "return 'x';",
          "tbelScript": "return \"Incoming message: \" + msg + \" metadata: \" + metadata;"
        },
        "additionalInfo": {
          "layoutX": 330,
          "layoutY": 640
        }
      },
      {
        "type": "org.thingsboard.rule.engine.filter.TbJsFilterNode",
        "name": "Has alarm_event?",
        "debugMode": false,
        "singletonMode": false,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "TBEL",
          "jsScript": "return true;",
          "tbelScript": "return msg.containsKey(\"alarm_event\") || (msg.containsKey(\"values\") && msg.values.containsKey(\"alarm_event\"));"
        },
        "additionalInfo": {
          "layoutX": 620,
          "layoutY": 200,
          "description": "True when the data has alarm_event (plain) or values.alarm_event (ts/values form)"
        }
      },
      {
        "type": "org.thingsboard.rule.engine.metadata.TbGetAttributesNode",
        "name": "Fetch last_alarm_event",
        "debugMode": false,
        "singletonMode": false,
        "configurationVersion": 1,
        "configuration": {
          "tellFailureIfAbsent": false,
          "getLatestValueWithTs": false,
          "clientAttributeNames": [],
          "sharedAttributeNames": [],
          "serverAttributeNames": [
            "last_alarm_event"
          ],
          "latestTsKeyNames": [],
          "fetchTo": "METADATA"
        },
        "additionalInfo": {
          "layoutX": 920,
          "layoutY": 200,
          "description": "Puts the server attribute into metadata as ss_last_alarm_event"
        }
      },
      {
        "type": "org.thingsboard.rule.engine.transform.TbTransformMsgNode",
        "name": "Normalize and dedupe",
        "debugMode": false,
        "singletonMode": false,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "TBEL",
          "jsScript": "return {msg: msg, metadata: metadata, msgType: msgType};",
          "tbelScript": "var ev = msg.containsKey(\"alarm_event\") ? msg.alarm_event : msg.values.alarm_event;\nvar dup = false;\nvar last = metadata.ss_last_alarm_event;\nif (last != null && last != \"\") {\n  var l = JSON.parse(last);\n  if (l.boot_id == ev.boot_id && ev.seq <= l.seq) {\n    dup = true;\n  }\n}\nvar route = \"other\";\nif (dup) {\n  route = \"drop\";\n} else if (ev.type == \"raised\") {\n  if (ev.severity == \"critical\") {\n    route = \"raise_critical\";\n  } else if (ev.severity == \"warning\") {\n    route = \"raise_warning\";\n  } else {\n    route = \"raise_info\";\n  }\n} else if (ev.type == \"cleared\") {\n  route = \"clear\";\n}\nmetadata.alarmType = \"rule_\" + ev.rule_id;\nmetadata.alarmRoute = route;\nmetadata.evBootId = \"\" + ev.boot_id;\nmetadata.evSeq = \"\" + ev.seq;\nreturn {msg: ev, metadata: metadata, msgType: msgType};"
        },
        "additionalInfo": {
          "layoutX": 1210,
          "layoutY": 200,
          "description": "data becomes the event object; metadata gets alarmType (rule_ plus rule id), alarmRoute, evBootId, evSeq"
        }
      },
