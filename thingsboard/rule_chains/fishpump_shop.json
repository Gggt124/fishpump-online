        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "TBEL",
          "jsScript": "return {msg: msg, metadata: metadata, msgType: msgType};",
          "tbelScript": "var res = {\"request_id\": null, \"method\": null, \"ok\": false, \"reply\": null, \"error\": \"bad_request\"};\nreturn {msg: {\"apply_result\": res}, metadata: metadata, msgType: \"POST_ATTRIBUTES_REQUEST\"};"
        },
        "additionalInfo": {
          "layoutX": 1200,
          "layoutY": 330,
          "description": "apply_request that is not an object"
        }
      }
    ],
