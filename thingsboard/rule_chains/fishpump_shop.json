{
  "ruleChain": {
    "additionalInfo": {
      "description": "fishpump shop path, default chain of the fishpump_shop asset profile. A technician writes the server attribute apply_request (request_id, method, params) on the shop asset of a board. This chain sends it as a two-way RPC to the board related by fishpump_board and writes apply_result (request_id, method, ok, reply, error) back on the asset. Customers cannot reach the asset."
    },
    "name": "fishpump_shop",
    "type": "CORE",
    "firstRuleNodeId": null,
    "root": false,
    "debugMode": false,
    "configuration": null
  },
  "metadata": {
    "version": 1,
    "firstNodeIndex": 0,
    "nodes": [
      {
        "type": "org.thingsboard.rule.engine.filter.TbMsgTypeSwitchNode",
        "name": "Message Type Switch",
        "debugSettings": {
          "failuresEnabled": true,
          "allEnabled": false,
          "allEnabledUntil": 0
        },
        "singletonMode": false,
        "configurationVersion": 0,
        "configuration": {
          "version": 0
        },
        "additionalInfo": {
          "layoutX": 300,
          "layoutY": 150
        }
      },
      {
        "type": "org.thingsboard.rule.engine.filter.TbJsSwitchNode",
        "name": "Check apply_request",
        "debugSettings": {
          "failuresEnabled": true,
          "allEnabled": false,
          "allEnabledUntil": 0
        },
        "singletonMode": false,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "TBEL",
          "jsScript": "return {msg: msg, metadata: metadata, msgType: msgType};",
          "tbelScript": "if (metadata.scope != \"SERVER_SCOPE\" || !msg.containsKey(\"apply_request\")) {\n    return [\"ignore\"];\n}\nvar r = msg.apply_request;\nif (r == null || r.request_id == null || r.method == null) {\n    return [\"invalid\"];\n}\nif ((\"\" + r.request_id) == \"\" || (\"\" + r.method) == \"\") {\n    return [\"invalid\"];\n}\nreturn [\"valid\"];"
        },
        "additionalInfo": {
          "layoutX": 600,
          "layoutY": 150,
          "description": "valid when the server attribute apply_request has request_id and method; ignore for any other attribute change"
        }
      },
      {
        "type": "org.thingsboard.rule.engine.transform.TbTransformMsgNode",
        "name": "Build RPC",
        "debugSettings": {
          "failuresEnabled": true,
          "allEnabled": false,
          "allEnabledUntil": 0
        },
        "singletonMode": false,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "TBEL",
          "jsScript": "return {msg: msg, metadata: metadata, msgType: msgType};",
          "tbelScript": "var r = msg.apply_request;\nmetadata.fp_request_id = \"\" + r.request_id;\nmetadata.fp_method = \"\" + r.method;\nvar params = r.params;\nif (params == null) {\n    params = {};\n}\nreturn {msg: {\"method\": metadata.fp_method, \"params\": params}, metadata: metadata, msgType: msgType};"
        },
        "additionalInfo": {
          "layoutX": 900,
          "layoutY": 60,
          "description": "request_id and method go into metadata as fp_request_id and fp_method. The message type stays as it came in; RPC_CALL_FROM_SERVER_TO_DEVICE would make the RPC node treat it as a REST call"
        }
      },
      {
        "type": "org.thingsboard.rule.engine.transform.TbChangeOriginatorNode",
        "name": "To board",
        "debugSettings": {
          "failuresEnabled": true,
          "allEnabled": false,
          "allEnabledUntil": 0
        },
        "singletonMode": false,
        "configurationVersion": 0,
        "configuration": {
          "originatorSource": "RELATED",
          "entityType": null,
          "entityNamePattern": null,
          "relationsQuery": {
            "direction": "FROM",
            "maxLevel": 1,
            "fetchLastLevelOnly": false,
            "filters": [
              {
                "relationType": "fishpump_board",
                "entityTypes": [
                  "DEVICE"
                ]
              }
            ]
          }
        },
        "additionalInfo": {
          "layoutX": 1200,
          "layoutY": 60
        }
      },
      {
        "type": "org.thingsboard.rule.engine.rpc.TbSendRPCRequestNode",
        "name": "Send to board",
        "debugSettings": {
          "failuresEnabled": true,
          "allEnabled": false,
          "allEnabledUntil": 0
        },
        "singletonMode": false,
        "configurationVersion": 0,
        "configuration": {
          "timeoutInSeconds": 20
        },
        "additionalInfo": {
          "layoutX": 1500,
          "layoutY": 60
        }
      },
      {
        "type": "org.thingsboard.rule.engine.transform.TbTransformMsgNode",
        "name": "Result from reply",
        "debugSettings": {
          "failuresEnabled": true,
          "allEnabled": false,
          "allEnabledUntil": 0
        },
        "singletonMode": false,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "TBEL",
          "jsScript": "return {msg: msg, metadata: metadata, msgType: msgType};",
          "tbelScript": "var ok = msg.ok == true;\nvar err = null;\nif (!ok) {\n    err = msg.error;\n    if (err == null) {\n        err = \"rpc_failed\";\n    }\n}\nvar res = {\"request_id\": metadata.fp_request_id, \"method\": metadata.fp_method, \"ok\": ok, \"reply\": msg, \"error\": err};\nreturn {msg: {\"apply_result\": res}, metadata: metadata, msgType: \"POST_ATTRIBUTES_REQUEST\"};"
        },
        "additionalInfo": {
          "layoutX": 1800,
          "layoutY": 0
        }
      },
      {
        "type": "org.thingsboard.rule.engine.transform.TbTransformMsgNode",
        "name": "Result from RPC failure",
        "debugSettings": {
          "failuresEnabled": true,
          "allEnabled": false,
          "allEnabledUntil": 0
        },
        "singletonMode": false,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "TBEL",
          "jsScript": "return {msg: msg, metadata: metadata, msgType: msgType};",
          "tbelScript": "var tbErr = msg.error;\nif (tbErr == null) {\n    tbErr = metadata.error;\n}\nvar err = \"rpc_failed\";\nif (tbErr == \"TIMEOUT\") {\n    err = \"no_reply\";\n} else if (tbErr == \"NO_ACTIVE_CONNECTION\") {\n    err = \"board_offline\";\n}\nvar res = {\"request_id\": metadata.fp_request_id, \"method\": metadata.fp_method, \"ok\": false, \"reply\": null, \"error\": err};\nreturn {msg: {\"apply_result\": res}, metadata: metadata, msgType: \"POST_ATTRIBUTES_REQUEST\"};"
        },
        "additionalInfo": {
          "layoutX": 1800,
          "layoutY": 120,
          "description": "TIMEOUT becomes no_reply, NO_ACTIVE_CONNECTION becomes board_offline, anything else rpc_failed"
        }
      },
      {
        "type": "org.thingsboard.rule.engine.transform.TbChangeOriginatorNode",
        "name": "Back to shop asset",
        "debugSettings": {
          "failuresEnabled": true,
          "allEnabled": false,
          "allEnabledUntil": 0
        },
        "singletonMode": false,
        "configurationVersion": 0,
        "configuration": {
          "originatorSource": "RELATED",
          "entityType": null,
          "entityNamePattern": null,
          "relationsQuery": {
            "direction": "TO",
            "maxLevel": 1,
            "fetchLastLevelOnly": false,
            "filters": [
              {
                "relationType": "fishpump_board",
                "entityTypes": [
                  "ASSET"
                ]
              }
            ]
          }
        },
        "additionalInfo": {
          "layoutX": 2100,
          "layoutY": 60
        }
      },
      {
        "type": "org.thingsboard.rule.engine.transform.TbTransformMsgNode",
        "name": "Result bad_request",
        "debugSettings": {
          "failuresEnabled": true,
          "allEnabled": false,
          "allEnabledUntil": 0
        },
        "singletonMode": false,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "TBEL",
          "jsScript": "return {msg: msg, metadata: metadata, msgType: msgType};",
          "tbelScript": "var r = msg.apply_request;\nvar id = null;\nvar method = null;\nif (r != null) {\n    if (r.request_id != null) {\n        id = \"\" + r.request_id;\n    }\n    if (r.method != null) {\n        method = \"\" + r.method;\n    }\n}\nvar res = {\"request_id\": id, \"method\": method, \"ok\": false, \"reply\": null, \"error\": \"bad_request\"};\nreturn {msg: {\"apply_result\": res}, metadata: metadata, msgType: \"POST_ATTRIBUTES_REQUEST\"};"
        },
        "additionalInfo": {
          "layoutX": 900,
          "layoutY": 240
        }
      },
      {
        "type": "org.thingsboard.rule.engine.transform.TbTransformMsgNode",
        "name": "Result no_board",
        "debugSettings": {
          "failuresEnabled": true,
          "allEnabled": false,
          "allEnabledUntil": 0
        },
        "singletonMode": false,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "TBEL",
          "jsScript": "return {msg: msg, metadata: metadata, msgType: msgType};",
          "tbelScript": "var res = {\"request_id\": metadata.fp_request_id, \"method\": metadata.fp_method, \"ok\": false, \"reply\": null, \"error\": \"no_board\"};\nreturn {msg: {\"apply_result\": res}, metadata: metadata, msgType: \"POST_ATTRIBUTES_REQUEST\"};"
        },
        "additionalInfo": {
          "layoutX": 1500,
          "layoutY": 240
        }
      },
      {
        "type": "org.thingsboard.rule.engine.telemetry.TbMsgAttributesNode",
        "name": "Save apply_result",
        "debugSettings": {
